{
  "name": "@jupyterlite/jscl-kernel-extension",
  "version": "0.1.0",
  "description": "JupyterLite - Common Lisp Kernel Extension",
  "homepage": "https://github.com/wiki3-ai/jscl-kernel",
  "bugs": {
    "url": "https://github.com/wiki3-ai/jscl-kernel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wiki3-ai/jscl-kernel.git"
  },
  "license": "BSD-3-Clause",
  "author": "JSCL Kernel Contributors",
  "sideEffects": [
    "style/**/*.css",
    "style/index.js"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "directories": {
    "lib": "lib/"
  },
  "files": [
    "lib/**/*.{d.ts,js,js.map}",
    "style/**/*.{css,js,png,svg}",
    "src/**/*.{ts,tsx}"
  ],
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc -b",
    "build:prod": "jlpm clean && jlpm build:lib && jlpm build:labextension",
    "clean": "jlpm clean:lib",
    "clean:all": "jlpm clean:lib && jlpm clean:labextension",
    "clean:labextension": "rimraf ../../jupyterlite_jscl_kernel/labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "install:extension": "jlpm build",
    "watch": "run-p watch:src watch:labextension",
    "watch:labextension": "jupyter labextension watch .",
    "watch:src": "tsc -w",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlite/jscl-kernel": "^0.1.0",
    "@jupyterlite/services": "^0.7.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^6.1.0",
    "@typescript-eslint/parser": "^6.1.0",
    "npm-run-all2": "^6.1.1",
    "rimraf": "~5.0.1",
    "typescript": "~5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../../jupyterlite_jscl_kernel/labextension",
    "sharedPackages": {
      "@jupyterlite/services": {
        "bundled": false,
        "singleton": true
      }
    },
    "_build": {
      "load": "static/remoteEntry.b5a3ea0a6a3117e3d124.js",
      "extension": "./extension",
      "style": "./style"
    }
  },
  "jupyterlite": {
    "liteExtension": true
  }
}
